+// 黑胶唱片：把封面按圆形遮罩贴出来，并整体旋转。
+//   逐目标像素做「逆旋转」采样：屏幕点 → 反向转到图像坐标 → 双线性取样；
+//   圆外一律不画（留黑）= 天然圆形遮罩，不需要额外的 alpha 掩码图。
+//
+//   **全部用定点整数**：这颗 1GHz ARMv7 的 VFP 是串行高延迟（实测 1e6 次 float 乘加要 70ms），
+//   浮点版每像素 30+ 次浮点 → 14-19ms/帧，30fps 就吃掉 ~57% 单核。定点后降到几毫秒。
+//   采样用 16.16 坐标 + 8 位权重（精度足够），并直接写后备缓冲（垂直翻转每行只算一次，
+//   不再逐像素调 fb_write_pixel 重复算镜像与边界）。
+static void draw_vinyl(FrameBuffer *fb, const Image *img, double angle_deg) {
+    double rad = angle_deg * VINYL_PI / 180.0;
+    const int CA = (int)(cos(rad) * 65536.0);          /* 16.16 定点 */
+    const int SA = (int)(sin(rad) * 65536.0);
+    const int cx = VINYL_CX, cy = VINYL_CY, R = VINYL_RADIUS;
+    const int r2max = R * R;
+    const int have_img = (img != NULL && img->width > 1 && img->height > 1);
+    const int iw = have_img ? img->width : 0;
+    const int ih = have_img ? img->height : 0;
+    const unsigned char *data = have_img ? img->data : NULL;
+    /* 归一化偏移 [-R,R] → 图像像素 [0,iw]：u*iw/(2R) + iw/2，都用 16.16 预存 */
+    const int sx_fp = have_img ? (int)(((long)iw << 16) / (2 * R)) : 0;
+    const int sy_fp = have_img ? (int)(((long)ih << 16) / (2 * R)) : 0;
+    const int ox_fp = have_img ? (iw << 15) : 0;
+    const int oy_fp = have_img ? (ih << 15) : 0;
+    unsigned short *bb = (unsigned short *)fb->back_buffer;
+
+    for (int y = cy - R; y <= cy + R; y++) {
+        if (y < 0 || y >= fb->height) continue;
+        int dy = y - cy;
+        int r2y = dy * dy;
+        int vs = -dy;
+        /* fb_write_pixel 会做垂直翻转（mirrored_y = height-1-y），这里每行算一次 */
+        unsigned short *row = bb + (long)(fb->height - 1 - y) * fb->width;
+        for (int x = cx - R; x <= cx + R; x++) {
+            if (x < 0 || x >= fb->width) continue;
+            int dx = x - cx;
+            if (dx * dx + r2y > r2max) continue;            /* 圆外：留黑 */
+
+            if (!have_img) {
+                row[x] = 0x18E3;                            /* rgb(24,24,24) 的 RGB565 */
+                continue;
+            }
+            /* 逆旋转：屏幕点 -> 图像坐标（代码 y 与可见 y 相反，所以 vs = -dy） */
+            int ui = (CA * dx + SA * vs) >> 16;
+            int vi = (-SA * dx + CA * vs) >> 16;
+            /* sx_fp 已是 16.16 的比例因子，ui*sx_fp 直接就是 16.16 像素坐标；
+               这里**不能**再 >>16 —— 多移一次会把结果降回 ±R 单位，加上 16.16 的 ox_fp
+               后 x0 几乎不变，整张图会退化成采样中心一个像素（曾因此封面变纯色）。 */
+            int fx = (int)((long)ui * sx_fp) + ox_fp;          /* 16.16 像素坐标 */
+            int fy = (int)((long)vi * sy_fp) + oy_fp;
+            int x0 = fx >> 16;
+            int y0 = fy >> 16;
+            int tx = (fx >> 8) & 0xFF;
+            int ty = (fy >> 8) & 0xFF;
+            if (x0 < 0) { x0 = 0; tx = 0; }
+            if (y0 < 0) { y0 = 0; ty = 0; }
+            if (x0 > iw - 2) { x0 = iw - 2; tx = 255; }
+            if (y0 > ih - 2) { y0 = ih - 2; ty = 255; }
+            const unsigned char *p00 = data + ((long)y0 * iw + x0) * 4;
+            const unsigned char *p10 = p00 + 4;
+            const unsigned char *p01 = data + ((long)(y0 + 1) * iw + x0) * 4;
+            const unsigned char *p11 = p01 + 4;
+            int w00 = ((256 - tx) * (256 - ty)) >> 8;
+            int w10 = (tx * (256 - ty)) >> 8;
+            int w01 = ((256 - tx) * ty) >> 8;
+            int w11 = 256 - w00 - w10 - w01;
+            unsigned char r = (unsigned char)((p00[0] * w00 + p10[0] * w10 + p01[0] * w01 + p11[0] * w11) >> 8);
+            unsigned char g = (unsigned char)((p00[1] * w00 + p10[1] * w10 + p01[1] * w01 + p11[1] * w11) >> 8);
+            unsigned char b = (unsigned char)((p00[2] * w00 + p10[2] * w10 + p01[2] * w01 + p11[2] * w11) >> 8);
+            row[x] = (unsigned short)(((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3));
+        }
+    }
+}
