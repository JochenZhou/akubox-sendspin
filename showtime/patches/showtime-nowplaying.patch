+// 丢掉原有查询串，改成服务端认识的参数：MA 的 imageproxy 只接受 size=80/160/256/512，
+// 且只有 fmt=png 能被本机（有 libpng、无 libjpeg 链接）解码。
+static void build_cover_url(const char *src, char *out, size_t cap) {
+    const char *q = strchr(src, '?');
+    size_t base = (q != NULL) ? (size_t)(q - src) : strlen(src);
+    if (base + 20 >= cap) base = cap - 21;
+    memcpy(out, src, base);
+    out[base] = '\0';
+    strcat(out, "?size=160&fmt=png");
+}
+
+static unsigned long url_hash(const char *s) {
+    unsigned long h = 2166136261UL;
+    while (*s != '\0') {
+        h ^= (unsigned char)*s++;
+        h *= 16777619UL;
+    }
+    return h;
+}
