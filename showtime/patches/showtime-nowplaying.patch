+// 等比缩放到 box x box 内，返回新图像（调用者用 free_image 释放）
+static Image *scale_image_fit(const Image *src, int box, int *out_w, int *out_h) {
+    if (src == NULL || src->width <= 0 || src->height <= 0) return NULL;
+    int tw, th;
+    if (src->width >= src->height) {
+        tw = box;
+        th = (int)((long)src->height * box / src->width);
+    } else {
+        th = box;
+        tw = (int)((long)src->width * box / src->height);
+    }
+    if (tw < 1) tw = 1;
+    if (th < 1) th = 1;
+    Image *dst = (Image *)malloc(sizeof(Image));
+    if (dst == NULL) return NULL;
+    dst->width = tw;
+    dst->height = th;
+    dst->data = (unsigned char *)malloc((size_t)tw * (size_t)th * 4);
+    if (dst->data == NULL) { free(dst); return NULL; }
+    // 面积平均降采样（源 160 -> 目标 96，比例 1.67，比最近邻干净）
+    for (int y = 0; y < th; y++) {
+        int sy0 = y * src->height / th;
+        int sy1 = (y + 1) * src->height / th;
+        if (sy1 <= sy0) sy1 = sy0 + 1;
+        if (sy1 > src->height) sy1 = src->height;
+        for (int x = 0; x < tw; x++) {
+            int sx0 = x * src->width / tw;
+            int sx1 = (x + 1) * src->width / tw;
+            if (sx1 <= sx0) sx1 = sx0 + 1;
+            if (sx1 > src->width) sx1 = src->width;
+            unsigned long r = 0, g = 0, b = 0, a = 0, n = 0;
+            for (int sy = sy0; sy < sy1; sy++) {
+                for (int sx = sx0; sx < sx1; sx++) {
+                    const unsigned char *p = src->data + ((size_t)sy * src->width + sx) * 4;
+                    r += p[0]; g += p[1]; b += p[2]; a += p[3];
+                    n++;
+                }
+            }
+            unsigned char *d = dst->data + ((size_t)y * tw + x) * 4;
+            if (n == 0) n = 1;
+            d[0] = (unsigned char)(r / n);
+            d[1] = (unsigned char)(g / n);
+            d[2] = (unsigned char)(b / n);
+            d[3] = (unsigned char)(a / n);
+        }
+    }
+    *out_w = tw;
+    *out_h = th;
+    return dst;
+}
+
+// URL 变化时才加载；失败返回 NULL（调用方降级为纯文字）
+static Image *get_cover(const char *artwork_url, int *out_w, int *out_h) {
+    static char loaded_url[512] = "";
+    static Image *cover = NULL;
+    static int cover_w = 0, cover_h = 0;
+
+    if (strcmp(artwork_url, loaded_url) == 0) {
+        *out_w = cover_w;
+        *out_h = cover_h;
+        return cover;
+    }
+    if (cover != NULL) { free_image(cover); cover = NULL; }
+    cover_w = 0;
+    cover_h = 0;
+    snprintf(loaded_url, sizeof(loaded_url), "%s", artwork_url);
+
+    if (artwork_url[0] == '\0') { *out_w = 0; *out_h = 0; return NULL; }
+
+    char url[640];
+    build_cover_url(artwork_url, url, sizeof(url));
+    char cache_path[256];
+    snprintf(cache_path, sizeof(cache_path), "%s/%08lx.png", COVER_CACHE_DIR, url_hash(url));
+
+    struct stat st;
+    if (stat(cache_path, &st) != 0 || st.st_size <= 0) {
+        mkdir(COVER_CACHE_DIR, 0755);   // 已存在返回 EEXIST，忽略
+        if (!http_get_file(url, cache_path)) {
+            unlink(cache_path);
+            *out_w = 0;
+            *out_h = 0;
+            return NULL;
+        }
+    }
+    Image *raw = load_png(cache_path);
+    if (raw == NULL) { *out_w = 0; *out_h = 0; return NULL; }
+    cover = scale_image_fit(raw, COVER_SIZE, &cover_w, &cover_h);
+    free_image(raw);
+    *out_w = cover_w;
+    *out_h = cover_h;
+    return cover;
+}
