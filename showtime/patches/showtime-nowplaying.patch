+/* COMPAT (akubox): WiFi 连接状态图标。
+ * 只读 sysfs，绝不 fork —— 这台单核 CPU 每帧 fork 的代价极高（曾因每帧 popen 白烧 60% 单核）。
+ * 状态来源：operstate=up 且 carrier=1 视为已连接。
+ * 注：/proc/net/wireless 在本机不可读，因此不做信号强度分级，只区分「已连接 / 未连接」。 */
+static int wifi_is_connected(void) {
+    char buf[16];
+    FILE *f = fopen("/sys/class/net/wlan0/operstate", "r");
+    if (f == NULL) return 0;
+    if (fgets(buf, sizeof(buf), f) == NULL) { fclose(f); return 0; }
+    fclose(f);
+    if (strncmp(buf, "up", 2) != 0) return 0;
+    f = fopen("/sys/class/net/wlan0/carrier", "r");
+    if (f == NULL) return 1;                 /* 拿不到 carrier 时按 operstate 判断 */
+    int c = fgetc(f);
+    fclose(f);
+    return c == '1';
+}
+
+/* 4 格信号柱（宽 3px、间隔 2px，共 18px）；未连接时整组画暗灰，一眼看出没连上 */
+static void draw_wifi_icon(FrameBuffer *fb, int x, int bottom_visible_row,
+                           unsigned char r, unsigned char g, unsigned char b) {
+    static const int heights[4] = {4, 7, 10, 13};
+    const int bar_w = 3, gap = 2;
+    int connected = wifi_is_connected();
+    for (int i = 0; i < 4; i++) {
+        int bx = x + i * (bar_w + gap);
+        for (int dy = 0; dy < heights[i]; dy++) {
+            int code_y = (fb->height - 1) - (bottom_visible_row - dy);
+            for (int dx = 0; dx < bar_w; dx++) {
+                if (connected) fb_write_pixel(fb, bx + dx, code_y, r, g, b);
+                else           fb_write_pixel(fb, bx + dx, code_y, 70, 70, 70);
+            }
+        }
+    }
+}
