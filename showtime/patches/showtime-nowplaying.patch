+// ==================== 正在播放（now playing） ====================
+// 数据来自 sendspin-client 写出的 key=value 文件：每行一个 "key=value"，
+// 客户端已把值里的换行替换为空格，所以按首个 '=' 切分即可。
+#define NOWPLAYING_PATH      "/var/lib/sendspin-client/nowplaying"
+#define CLOCK_RESUME_DELAY_S 5
+
+typedef struct {
+    int  playing;
+    char title[256];
+    char artist[256];
+    char album[256];
+    char artwork_url[512];
+} NowPlaying;
+
+static void np_set(char *dst, size_t cap, const char *src) {
+    if (cap == 0) return;
+    snprintf(dst, cap, "%s", (src != NULL) ? src : "");
+}
+
+// 读取播放信息；返回 1 表示读到了文件（内容可能为空）
+static int read_nowplaying(NowPlaying *np) {
+    FILE *f = fopen(NOWPLAYING_PATH, "r");
+    if (f == NULL) return 0;
+    memset(np, 0, sizeof(*np));
+    char line[1024];
+    while (fgets(line, sizeof(line), f) != NULL) {
+        size_t n = strlen(line);
+        while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r')) line[--n] = '\0';
+        char *eq = strchr(line, '=');
+        if (eq == NULL) continue;
+        *eq = '\0';
+        const char *key = line;
+        const char *val = eq + 1;
+        if (strcmp(key, "state") == 0) {
+            np->playing = (strcmp(val, "playing") == 0);
+        } else if (strcmp(key, "title") == 0) {
+            np_set(np->title, sizeof(np->title), val);
+        } else if (strcmp(key, "artist") == 0) {
+            np_set(np->artist, sizeof(np->artist), val);
+        } else if (strcmp(key, "album") == 0) {
+            np_set(np->album, sizeof(np->album), val);
+        } else if (strcmp(key, "artwork_url") == 0) {
+            np_set(np->artwork_url, sizeof(np->artwork_url), val);
+        }
+    }
+    fclose(f);
+    return 1;
+}
+
+static int utf8_seq_len(unsigned char c) {
+    if ((c & 0x80) == 0) return 1;
+    if ((c & 0xE0) == 0xC0) return 2;
+    if ((c & 0xF0) == 0xE0) return 3;
+    if ((c & 0xF8) == 0xF0) return 4;
+    return 1;
+}
+
+// 按像素宽度截断 UTF-8 文本，放不下时以「…」收尾
+static void truncate_to_width(FontRenderer *fr, const char *src, char *out, size_t out_cap,
+                              int font_size, int is_chinese, int max_width) {
+    size_t oi = 0;
+    int w = 0;
+    if (out_cap == 0) return;
+    for (size_t i = 0; src[i] != '\0'; ) {
+        int cl = utf8_seq_len((unsigned char)src[i]);
+        if (cl >= 8) cl = 1;
+        if ((size_t)cl + 1 >= out_cap - oi) break;
+        char one[8];
+        memcpy(one, src + i, (size_t)cl);
+        one[cl] = '\0';
+        int cw = get_text_width(fr, one, font_size, is_chinese);
+        if (w + cw > max_width) {
+            if (out_cap - oi > 4) {
+                out[oi++] = (char)0xE2;   // 「…」的 UTF-8 编码
+                out[oi++] = (char)0x80;
+                out[oi++] = (char)0xA6;
+            }
+            break;
+        }
+        memcpy(out + oi, one, (size_t)cl);
+        oi += (size_t)cl;
+        w += cw;
+        i += (size_t)cl;
+    }
+    out[oi] = '\0';
+}
+
+// 布局 C：封面 96x96 在 (COVER_X, COVER_Y)
+// 注意 fb_write_pixel 会做垂直翻转（mirrored_y = height-1-y），所以 y 越大越靠屏幕上方：
+// 可见行 ≈ 131 - (y + 字号)。下面三个 Y 值是按「可见行」反推的。，歌名 14px 在 y=100，歌手 12px 在 y=116
+#define COVER_X      33
+#define COVER_Y      34
+#define COVER_SIZE   96
+#define TITLE_Y      4
+#define TITLE_SIZE   14
+#define ARTIST_Y     -8
+#define ARTIST_SIZE  12
+
+// ==================== 专辑封面（步骤 2） ====================
+#define COVER_CACHE_DIR "/tmp/showtime-cover-cache"
+
+// 丢掉原有查询串，改成服务端认识的参数：MA 的 imageproxy 只接受 size=80/160/256/512，
+// 且只有 fmt=png 能被本机（有 libpng、无 libjpeg 链接）解码。
+static void build_cover_url(const char *src, char *out, size_t cap) {
+    const char *q = strchr(src, '?');
+    size_t base = (q != NULL) ? (size_t)(q - src) : strlen(src);
+    if (base + 20 >= cap) base = cap - 21;
+    memcpy(out, src, base);
+    out[base] = '\0';
+    strcat(out, "?size=160&fmt=png");
+}
+
+static unsigned long url_hash(const char *s) {
+    unsigned long h = 2166136261UL;
+    while (*s != '\0') {
+        h ^= (unsigned char)*s++;
+        h *= 16777619UL;
+    }
+    return h;
+}
+
+static int http_get_file(const char *url, const char *path) {
+    CURL *c = curl_easy_init();
+    if (c == NULL) return 0;
+    FILE *fp = fopen(path, "wb");
+    if (fp == NULL) { curl_easy_cleanup(c); return 0; }
+    curl_easy_setopt(c, CURLOPT_URL, url);
+    curl_easy_setopt(c, CURLOPT_WRITEDATA, fp);
+    curl_easy_setopt(c, CURLOPT_CONNECTTIMEOUT, 4L);
+    curl_easy_setopt(c, CURLOPT_TIMEOUT, 10L);
+    curl_easy_setopt(c, CURLOPT_FOLLOWLOCATION, 1L);
+    curl_easy_setopt(c, CURLOPT_FAILONERROR, 1L);
+    curl_easy_setopt(c, CURLOPT_USERAGENT, "akubox-showtime/1.0");
+    CURLcode rc = curl_easy_perform(c);
+    curl_easy_cleanup(c);
+    fclose(fp);
+    return rc == CURLE_OK;
+}
