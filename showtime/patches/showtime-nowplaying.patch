+static void draw_song_screen(FrameBuffer *fb, FontRenderer *fr, const NowPlaying *np) {
+    char tmp[260];
+
+    // 封面：底边固定在可见行 97（代码坐标 y=COVER_Y），所以文字位置不随封面高度变化
+    int cover_w = 0, cover_h = 0;
+    Image *cover = get_cover(np->artwork_url, &cover_w, &cover_h);
+    if (cover != NULL && cover_w > 0 && cover_h > 0) {
+        draw_image(fb, cover, COVER_X + (COVER_SIZE - cover_w) / 2, COVER_Y);
+    }
+    if (np->title[0] != '\0') {
+        truncate_to_width(fr, np->title, tmp, sizeof(tmp), TITLE_SIZE, 1, fb->width);
+        int w = get_text_width(fr, tmp, TITLE_SIZE, 1);
+        draw_text(fb, fr, tmp, (fb->width - w) / 2, TITLE_Y, 255, 255, 255, TITLE_SIZE, 1);
+    } else {
+        const char *unknown = "未知曲目";
+        int w = get_text_width(fr, unknown, TITLE_SIZE, 1);
+        draw_text(fb, fr, unknown, (fb->width - w) / 2, TITLE_Y, 130, 130, 130, TITLE_SIZE, 1);
+    }
+    if (np->artist[0] != '\0') {
+        truncate_to_width(fr, np->artist, tmp, sizeof(tmp), ARTIST_SIZE, 1, fb->width);
+        int w = get_text_width(fr, tmp, ARTIST_SIZE, 1);
+        draw_text(fb, fr, tmp, (fb->width - w) / 2, ARTIST_Y, 150, 150, 150, ARTIST_SIZE, 1);
+    }
+}
