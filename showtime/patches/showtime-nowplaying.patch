+// ==================== 正在播放（now playing） ====================
+// 数据来自 sendspin-client 写出的 key=value 文件：每行一个 "key=value"，
+// 客户端已把值里的换行替换为空格，所以按首个 '=' 切分即可。
+#define NOWPLAYING_PATH      "/var/lib/sendspin-client/nowplaying"
+#define CLOCK_RESUME_DELAY_S 5
+
+typedef struct {
+    int  playing;
+    char title[256];
+    char artist[256];
+    char album[256];
+    char artwork_url[512];
+} NowPlaying;
+
+static void np_set(char *dst, size_t cap, const char *src) {
+    if (cap == 0) return;
+    snprintf(dst, cap, "%s", (src != NULL) ? src : "");
+}
+
+// 读取播放信息；返回 1 表示读到了文件（内容可能为空）
+static int read_nowplaying(NowPlaying *np) {
+    FILE *f = fopen(NOWPLAYING_PATH, "r");
+    if (f == NULL) return 0;
+    memset(np, 0, sizeof(*np));
+    char line[1024];
+    while (fgets(line, sizeof(line), f) != NULL) {
+        size_t n = strlen(line);
+        while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r')) line[--n] = '\0';
+        char *eq = strchr(line, '=');
+        if (eq == NULL) continue;
+        *eq = '\0';
+        const char *key = line;
+        const char *val = eq + 1;
+        if (strcmp(key, "state") == 0) {
+            np->playing = (strcmp(val, "playing") == 0);
+        } else if (strcmp(key, "title") == 0) {
+            np_set(np->title, sizeof(np->title), val);
+        } else if (strcmp(key, "artist") == 0) {
+            np_set(np->artist, sizeof(np->artist), val);
+        } else if (strcmp(key, "album") == 0) {
+            np_set(np->album, sizeof(np->album), val);
+        } else if (strcmp(key, "artwork_url") == 0) {
+            np_set(np->artwork_url, sizeof(np->artwork_url), val);
+        }
+    }
+    fclose(f);
+    return 1;
+}
