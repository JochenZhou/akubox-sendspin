+// ==================== nowplaying 桥接（COMPAT PATCH akubox） ====================
+// 设备上的显示程序（showtime）每秒轮询这个文件。格式为每行一个 "key=value"，值里的换行
+// 已替换成空格，所以读取端按第一个 '=' 切分即可。先写临时文件再 rename，读取端不会读到写
+// 到一半的内容。显示是尽力而为：这里任何失败都忽略，绝不影响播放。
+static std::string g_nowplaying_path;
+static bool        g_np_playing = false;
+static std::string g_np_title, g_np_artist, g_np_album, g_np_url;
+
+static std::string np_flatten(const std::string& in) {
+    std::string out = in;
+    for (char& c : out) {
+        if (c == '\n' || c == '\r') c = ' ';
+    }
+    return out;
+}
+
+static void nowplaying_write(bool playing) {
+    if (g_nowplaying_path.empty()) return;
+    const std::string tmp = g_nowplaying_path + ".tmp";
+    FILE* f = fopen(tmp.c_str(), "w");
+    if (f == nullptr) return;
+    fprintf(f, "state=%s\n", playing ? "playing" : "idle");
+    if (!g_np_title.empty())  fprintf(f, "title=%s\n", np_flatten(g_np_title).c_str());
+    if (!g_np_artist.empty()) fprintf(f, "artist=%s\n", np_flatten(g_np_artist).c_str());
+    if (!g_np_album.empty())  fprintf(f, "album=%s\n", np_flatten(g_np_album).c_str());
+    if (!g_np_url.empty())    fprintf(f, "artwork_url=%s\n", np_flatten(g_np_url).c_str());
+    fclose(f);
+    rename(tmp.c_str(), g_nowplaying_path.c_str());
+}
+
